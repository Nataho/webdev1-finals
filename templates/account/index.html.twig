{% extends 'base.html.twig' %}

{% block title %}My Account | Estrera Botanicals{% endblock %}
{% block body_class %}account-page{% endblock %}

{% block javascripts %}
{{ parent() }}

<link rel="stylesheet" href="{{asset('styles/account.css')}}">
{% endblock %}

{% block body %}
<main class="account-container">
    <div class="account-header-bar">
        <div>
            <h1>Account Settings</h1>
            <p style="margin: 4px 0 0 0; color: var(--palette-gray); font-size: 0.95rem;">
                Manage your personal account preferences and access.
            </p>
        </div>
        <button type="button" class="account-btn secondary" onclick="ConfirmModal.open('logoutModal')">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
        </button>
    </div>

    {% set success_flashes = app.flashes('success') %}
    {% set error_flashes = app.flashes('error') %}

    {% for message in success_flashes %}
        <div class="account-alert ok">
            <i class="fa-solid fa-circle-check"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    {% for message in error_flashes %}
        <div class="account-alert err">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="account-grid">
        <!-- Sidebar / Profile Card & Left Tabs -->
        <aside class="profile-card">

            <div class="profile-avatar-container">
                {% if avatar_file %}
                    <img src="{{ asset('uploads/avatars/' ~ avatar_file) }}" alt="Profile Picture" class="profile-avatar">
                {% else %}
                    <div class="profile-avatar-placeholder">
                        <i class="fa-solid fa-user"></i>
                    </div>
                {% endif %}
            </div>

            <h3>{{ user.username ?? 'User' }}</h3>
            <p class="user-email">{{ user.email ?? '' }}</p>
            <span class="profile-badge">{{ user.role ?? 'Customer' }}</span>

            <!-- Avatar Change Form -->
            <form class="avatar-upload-form" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="action" value="update_avatar">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('update_avatar') }}">
                <label for="avatar_input" class="avatar-upload-label" title="Click to select a new profile photo">
                    <i class="fa-solid fa-camera"></i> Change Photo
                </label>
                <input type="file" id="avatar_input" name="avatar" accept="image/*" required class="avatar-upload-input" onchange="this.form.submit()">
            </form>

            <!-- Left Navigation Tabs -->
            <nav class="account-nav-tabs">
                <a href="?tab=general" class="account-nav-tab {{ active_tab == 'general' ? 'active' : '' }}">
                    <i class="fa-solid fa-user-gear"></i> General & Security
                </a>
                <a href="?tab=payment_options" class="account-nav-tab {{ active_tab == 'payment_options' ? 'active' : '' }}">
                    <i class="fa-solid fa-wallet"></i> Payment Options
                </a>
                <a href="?tab=addresses" class="account-nav-tab {{ active_tab == 'addresses' ? 'active' : '' }}">
                    <i class="fa-solid fa-location-dot"></i> Addresses
                </a>
                <a href="?tab=logs" class="account-nav-tab {{ active_tab == 'logs' ? 'active' : '' }}">
                    <i class="fa-solid fa-clock-rotate-left"></i> {% if is_granted("ROLE_STAFF") %} Store Logs & Orders {% else %} My Orders {% endif %}
                </a>

                {% if is_granted("ROLE_ADMIN") %}
                    <div class="nav-group-title">Admin Controls</div>
                    <a href="?tab=dashboard" class="account-nav-tab {{ active_tab == 'dashboard' ? 'active' : '' }}">
                        <i class="fa-solid fa-chart-line"></i> Dashboard
                    </a>
                    <a href="?tab=users" class="account-nav-tab {{ active_tab == 'users' ? 'active' : '' }}">
                        <i class="fa-solid fa-users"></i> Manage Users
                    </a>
                    <a href="?tab=stock" class="account-nav-tab {{ active_tab == 'stock' ? 'active' : '' }}">
                        <i class="fa-solid fa-boxes-stacked"></i> Stock & Inventory
                    </a>
                    <a href="?tab=add_product" class="account-nav-tab {{ active_tab == 'add_product' ? 'active' : '' }}">
                        <i class="fa-solid fa-plus-circle"></i> Add New Product
                    </a>
                {% elseif is_granted("ROLE_STAFF") %}
                    <div class="nav-group-title">Staff Controls</div>
                    <a href="?tab=stock" class="account-nav-tab {{ active_tab == 'stock' ? 'active' : '' }}">
                        <i class="fa-solid fa-boxes-stacked"></i> Stock & Inventory
                    </a>
                    <a href="?tab=add_product" class="account-nav-tab {{ active_tab == 'add_product' ? 'active' : '' }}">
                        <i class="fa-solid fa-plus-circle"></i> Add New Product
                    </a>
                {% endif %}
            </nav>
        </aside>

        <!-- Main Tab Content Area -->
        <div class="account-panels">
            {% if active_tab == "dashboard" %}
                {% include "partials/account_tabs/dashboard.html.twig" %}

            {% elseif active_tab == "logs" %}
                {% include "partials/account_tabs/logs.html.twig" %}

            {% elseif active_tab == "payment_options" %}
                {% include "partials/account_tabs/payment_options.html.twig" %}

            {% elseif active_tab == "addresses" %}
                {% include "partials/account_tabs/addresses.html.twig" %}

            {% elseif active_tab == "users" %}
                {% include "partials/account_tabs/users.html.twig" %}

            {% elseif active_tab == "stock" %}
                {% include "partials/account_tabs/stock.html.twig" %}

            {% elseif active_tab == "add_product" %}
                {% include "partials/account_tabs/add_product.html.twig" %}

            {% else %}
                {% include "partials/account_tabs/general.html.twig" %}

            {% endif %}
        </div>
    </div>
</main>

<!-- Modals -->
{% include 'partials/modals/confirm.html.twig' with {
    id: 'logoutModal',
    message: 'Are you sure you want to log out?',
    confirm_label: 'Log Out',
    cancel_label: 'Cancel',
    confirm_class: 'secondary',
    action_url: path('app_logout'),
    method: 'POST',
    hidden: {},
} %}

{% if not is_granted('ROLE_ADMIN') %}
    {% include 'partials/modals/confirm_type.html.twig' with {
        id: 'deleteModal',
        message: 'Are you sure you want to permanently delete your account?',
        word: delete_account_word,
        confirm_label: 'Delete My Account',
        cancel_label: 'Cancel',
        action_url: path('app_account'),
        method: 'POST',
        hidden: { action: 'delete_account' },
        csrf_token_id: 'delete_account',
    } %}

    {% include 'partials/modals/cancel_order.html.twig' with {
        id: 'cancelOrderModal',
        message: 'Cancel this order? This cannot be undone and goes to the shop.',
        action_url: path('app_account'),
    } %}

    <script>
        // set the order_id for the cancel modal, clear the previous reason and open it
        function prepareCancelOrder(orderId) {
            var modal = document.getElementById('cancelOrderModal');
            modal.querySelector('input[name="order_id"]').value = orderId;
            var reason = modal.querySelector('textarea[name="cancel_reason"]');
            reason.value = '';
            modal.querySelector('button[type="submit"]').disabled = true;
            ConfirmModal.open('cancelOrderModal');
            reason.focus();
        }
    </script>
{% endif %}

{% if is_granted('ROLE_STAFF') %}
    {% include 'partials/modals/confirm_type.html.twig' with {
        id: 'deleteProductModal',
        message: 'Are you sure you want to permanently delete this product? This cannot be undone.',
        word: 'DELETE_PLANT_PRODUCT',
        confirm_label: 'Delete Product',
        cancel_label: 'Cancel',
        action_url: path('app_account'),
        method: 'POST',
        hidden: { action: 'delete_product', product_id: '' },
        csrf_token_id: 'delete_product',
    } %}
{% endif %}

{% if is_granted('ROLE_ADMIN') %}
    {% include 'partials/modals/confirm_type.html.twig' with {
        id: 'deleteUserModal',
        message: 'Are you sure you want to permanently delete this user account? This cannot be undone.',
        word: 'DELETE_USER_ACCOUNT',
        confirm_label: 'Delete User',
        cancel_label: 'Cancel',
        action_url: path('app_account'),
        method: 'POST',
        hidden: { action: 'delete_user', target_user_id: '' },
        csrf_token_id: 'delete_user',
    } %}

    {% include 'partials/modals/add_user.html.twig' %}

    {% include 'partials/modals/edit_user.html.twig' %}
{% endif %}

{% set alert_type = success_flashes ? 'success' : 'error' %}
{% set alert_message = success_flashes ? success_flashes|last : (error_flashes ? error_flashes|last : null) %}
{% if alert_message %}
    {% include 'partials/modals/alert.html.twig' with {
        id: 'accountAlertModal',
        message: alert_message,
        type: alert_type,
        button_label: alert_type == 'success' ? 'Continue' : 'Okay',
    } %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            AlertModal.open('accountAlertModal');
        });
    </script>
{% endif %}

{% include 'partials/modals/scripts.html.twig' %}

{% if is_granted('ROLE_STAFF') %}
<script>
    // set the product_id in the delete product modal before opening it
    function prepareDeleteProduct(productId) {
        document.querySelector('#deleteProductModal input[name="product_id"]').value = productId;
        ConfirmTypeModal.open('deleteProductModal');
    }
</script>
{% endif %}

{% if is_granted('ROLE_ADMIN') %}
<script>
    // set the target_user_id in the delete user modal before opening it
    function prepareDeleteUser(userId) {
        document.querySelector('#deleteUserModal input[name="target_user_id"]').value = userId;
        ConfirmTypeModal.open('deleteUserModal');
    }

    // open the add-user modal with clean fields
    function prepareAddUser() {
        var modal = document.getElementById('addUserModal');
        modal.querySelectorAll('input[type="text"], input[type="email"], input[type="password"]').forEach(function (input) {
            input.value = '';
        });
        modal.querySelector('#new_user_role').value = 'customer';
        ConfirmModal.open('addUserModal');
    }

    // fill the edit-user modal from the clicked row's data attributes
    function prepareEditUser(button) {
        var modal = document.getElementById('editUserModal');
        var form = modal.querySelector('form');

        form.querySelector('input[name="target_user_id"]').value = button.dataset.userId;
        form.querySelector('#edit_user_name').value = button.dataset.userName;
        form.querySelector('#edit_user_email').value = button.dataset.userEmail;

        // banned rows swap the role select for the ban notice
        var isBanned = button.dataset.userRole === 'banned';
        var roleField = document.getElementById('edit_user_role_field');
        var banNote = document.getElementById('edit_user_ban_note');
        var roleSelect = form.querySelector('#edit_user_role');
        roleField.style.display = isBanned ? 'none' : '';
        banNote.style.display = isBanned ? '' : 'none';
        // a hidden required select would block form submission
        roleSelect.required = !isBanned;
        if (!isBanned) {
            roleSelect.value = button.dataset.userRole;
        }

        form.querySelector('#edit_user_password').value = '';
        ConfirmModal.open('editUserModal');
    }
</script>
{% endif %}
{% endblock %}
