{% extends 'base.html.twig' %}

{% block title %}Order #{{ '%05d'|format(order.id) }} Summary | Estrera Botanicals{% endblock %}
{% block body_class %}account-page{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('styles/account.css') }}">
{% endblock %}

{% block body %}
{% from 'partials/order_status_badge.html.twig' import badge %}
<link rel="stylesheet" href="{{ asset('styles/checkout.css') }}">

<main class="summary-container">
    <div class="summary-card">
        {% if just_placed %}
            <div class="summary-banner">
                <i class="fa-solid fa-circle-check"></i>
                <div>
                    <h3>Thank You! Order Placed Successfully</h3>
                    <p>Your botanical order has been registered and inventory has been reserved.</p>
                </div>
            </div>
        {% endif %}

        <div class="panel-header-row" style="margin-bottom: 24px;">
            <div>
                <h2 style="font-family: var(--heading-font); color: var(--palette-dark-green); font-size: 1.8rem; margin: 0 0 6px 0;">
                    Order #{{ '%05d'|format(order.id) }}
                </h2>
                <p class="subtext" style="margin: 0;">Official purchase record &amp; checkout summary</p>
            </div>
            {{ badge(order.status, 'font-size: 0.95rem; padding: 6px 14px;', 'circle-notch') }}
        </div>

        <!-- Order Metadata Grid -->
        <div class="order-meta-grid">
            <div class="order-meta-item">
                <label>Order Date</label>
                <span>{{ order.orderDate ? order.orderDate|date('M d, Y · h:i A') : '' }}</span>
            </div>
            <div class="order-meta-item">
                <label>Customer Name</label>
                <span>{{ order.user.username|default('User') }}</span>
            </div>
            <div class="order-meta-item">
                <label>Customer Email</label>
                <span style="font-size: 0.9rem; font-weight: 500;">{{ order.user.email|default('N/A') }}</span>
            </div>
            <div class="order-meta-item">
                <label>Payment Method</label>
                <span>
                    {% if order.paymentMethod == 'gcash' %}
                        <i class="fa-solid fa-mobile-screen-button"></i> GCash
                        {% set gcash_detail = order.paymentDetails ?: app.user.gcashNumber|default('') %}
                        {% if gcash_detail %}
                            <span style="font-weight: 500; color: #406040; margin-left: 4px;">({{ gcash_detail }})</span>
                        {% endif %}
                    {% elseif order.paymentMethod == 'card' %}
                        <i class="fa-solid fa-credit-card"></i> Credit / Debit Card
                        {% set card_detail = order.paymentDetails ?: (app.user.cardNumber ? '•••• •••• •••• ' ~ app.user.cardNumber|slice(-4) : '') %}
                        {% if card_detail %}
                            <span style="font-weight: 500; color: #406040; margin-left: 4px;">({{ card_detail }})</span>
                        {% endif %}
                    {% else %}
                        <i class="fa-solid fa-hand-holding-dollar"></i> Cash on Delivery
                    {% endif %}
                </span>
            </div>
            <div class="order-meta-item">
                <label>Viewing As</label>
                <span style="color: var(--palette-light-green);">{{ is_admin ? 'Administrator' : 'Customer' }}</span>
            </div>
            <div class="order-meta-item" style="grid-column: 1 / -1; border-top: 1px dashed #d8e2d7; padding-top: 10px; margin-top: 2px;">
                <label><i class="fa-solid fa-location-dot" style="color: var(--palette-light-green);"></i> Delivery Address</label>
                <span style="font-weight: 500; color: #2d3748;">
                    {{ order.deliveryAddress ?: 'Standard Delivery Destination' }}
                    {% if order.recipientName or order.recipientPhone %}
                        <span style="display: block; font-size: 0.85rem; color: var(--palette-gray); margin-top: 2px;">
                            Recipient: <strong>{{ order.recipientName ?: order.user.username|default('User') }}</strong>
                            {% if order.recipientPhone %} · {{ order.recipientPhone }}{% endif %}
                        </span>
                    {% endif %}
                </span>
            </div>
            {% if order.status|lower == 'cancelled' and order.cancelReason %}
                <div class="order-meta-item" style="grid-column: 1 / -1; border-top: 1px dashed #d8e2d7; padding-top: 10px; margin-top: 2px;">
                    <label><i class="fa-solid fa-circle-exclamation" style="color: #b91c1c;"></i> Cancellation Reason</label>
                    <span style="font-weight: 500; color: #7f1d1d;">&ldquo;{{ order.cancelReason }}&rdquo;</span>
                </div>
            {% endif %}
        </div>

        <!-- Items Purchased Table -->
        <div class="table-responsive">
            <table class="summary-table">
                <thead>
                    <tr>
                        <th>Botanical Product</th>
                        <th style="text-align: center;">Price</th>
                        <th style="text-align: center;">Qty</th>
                        <th style="text-align: right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {% set row_img = item.product.imageUrl ? asset(item.product.imageUrl) : asset('images/3.png') %}
                        <tr>
                            <td>
                                <img src="{{ row_img }}" alt="" class="summary-table-thumb">
                                <strong>{{ item.product.productName }}</strong>
                            </td>
                            <td style="text-align: center;">₱{{ item.priceAtPurchase|number_format(2) }}</td>
                            <td style="text-align: center; font-weight: 700;">{{ item.quantity }}</td>
                            <td style="text-align: right; font-weight: 700;">₱{{ (item.priceAtPurchase * item.quantity)|number_format(2) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Summary Totals -->
        <div class="summary-totals-box">
            <div class="summary-totals-row">
                <span>Subtotal:</span>
                <strong>₱{{ order.totalAmount|number_format(2) }}</strong>
            </div>
            <div class="summary-totals-row">
                <span>Shipping:</span>
                <strong style="color: var(--palette-light-green);">FREE</strong>
            </div>
            <div class="summary-totals-row grand">
                <span>Grand Total:</span>
                <span>₱{{ order.totalAmount|number_format(2) }}</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="summary-footer-actions">
            <div style="display: flex; gap: 10px;">
                <a href="{{ path('app_account', {tab: 'logs'}) }}" class="account-btn secondary" style="text-decoration: none;">
                    <i class="fa-solid fa-clock-rotate-left"></i> View Order Logs
                </a>
                <a href="{{ path('app_shop') }}" class="account-btn outline" style="text-decoration: none;">
                    <i class="fa-solid fa-arrow-left"></i> Return to Shop
                </a>
            </div>
            <button type="button" class="account-btn outline" onclick="window.print()">
                <i class="fa-solid fa-print"></i> Print Invoice
            </button>
        </div>
    </div>
</main>
{% endblock %}
