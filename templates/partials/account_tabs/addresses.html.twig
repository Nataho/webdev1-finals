<section class="account-panel">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
        <div>
            <h2><i class="fa-solid fa-location-dot" style="color: var(--palette-light-green); margin-right: 8px;"></i> Delivery Addresses</h2>
            <p class="subtext" style="margin: 0;">Manage your delivery destinations for botanical orders.</p>
        </div>
        <button type="button" class="account-btn" onclick="openAddressModal('add')">
            <i class="fa-solid fa-plus"></i> Add New Address
        </button>
    </div>

    {% if addresses is empty %}
        <div style="text-align: center; padding: 40px 20px; background: #fafcfa; border: 1.5px dashed #d8e2d7; border-radius: 12px; margin-top: 10px;">
            <i class="fa-solid fa-map-location-dot" style="font-size: 2.8rem; color: #a4bfa4; margin-bottom: 12px; display: inline-block;"></i>
            <h3 style="margin: 0 0 6px 0; color: var(--palette-dark-green); font-size: 1.1rem;">No Delivery Addresses Saved</h3>
            <p style="color: var(--palette-gray); font-size: 0.9rem; margin: 0 0 16px 0;">Add your shipping address to experience swift, seamless checkout.</p>
            <button type="button" class="account-btn" onclick="openAddressModal('add')">
                <i class="fa-solid fa-plus"></i> Add Address Now
            </button>
        </div>
    {% else %}
        <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 14px;">
            {% for addr in addresses %}
                <div style="padding: 18px 20px; background: #ffffff; border: 1.5px solid {{ addr.isDefault ? 'var(--palette-light-green)' : '#e2e8e2' }}; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.03); position: relative; transition: all 0.2s ease;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 10px;">
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <span style="font-weight: 700; color: var(--palette-dark-green); font-size: 1rem;">
                                {{ addr.label|default('Home') }}
                            </span>
                            {% if addr.isDefault %}
                                <span class="badge-status active" style="font-size: 0.72rem; padding: 3px 8px;">
                                    <i class="fa-solid fa-circle-check"></i> Default
                                </span>
                            {% endif %}
                        </div>

                        <!-- Action controls -->
                        <div style="display: flex; align-items: center; gap: 8px;">
                            {% if not addr.isDefault %}
                                <form method="POST" action="{{ path('app_account') }}" style="margin: 0;">
                                    <input type="hidden" name="action" value="set_default_address">
                                    <input type="hidden" name="address_id" value="{{ addr.id }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('set_default_address') }}">
                                    <button type="submit" class="account-btn secondary" style="padding: 4px 10px; font-size: 0.8rem;" title="Set as default delivery address">
                                        Set as Default
                                    </button>
                                </form>
                            {% endif %}

                            {# the modal prefill reads the same snake_case keys as before, fed from the entity here #}
                            {% set addr_json = {
                                address_id: addr.id,
                                label: addr.label,
                                recipient_name: addr.recipientName,
                                phone_number: addr.phoneNumber,
                                region: addr.region,
                                province: addr.province,
                                city: addr.city,
                                barangay: addr.barangay,
                                postal_code: addr.postalCode,
                                street_address: addr.streetAddress,
                                is_default: addr.isDefault,
                            } %}
                            <button type="button" class="account-btn secondary" style="padding: 4px 10px; font-size: 0.8rem;" onclick='openEditAddressModal({{ addr_json|json_encode|e('html_attr') }})'>
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </button>

                            <form method="POST" action="{{ path('app_account') }}" onsubmit="return confirm('Are you sure you want to delete this address?');" style="margin: 0;">
                                <input type="hidden" name="action" value="delete_address">
                                <input type="hidden" name="address_id" value="{{ addr.id }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_address') }}">
                                <button type="submit" class="account-btn secondary" style="padding: 4px 8px; font-size: 0.8rem; color: #b91c1c; border-color: #fca5a5;" title="Delete Address">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div style="font-size: 0.95rem; color: #2d3748; line-height: 1.5;">
                        <div style="font-weight: 600; margin-bottom: 2px;">
                            {{ addr.recipientName }}
                            <span style="font-weight: 400; color: var(--palette-gray); margin-left: 10px; font-size: 0.88rem;">
                                <i class="fa-solid fa-phone" style="font-size: 0.8rem;"></i> {{ addr.phoneNumber }}
                            </span>
                        </div>
                        <div style="color: #4a5568; font-size: 0.9rem;">
                            {{ addr.streetAddress }}, Brgy. {{ addr.barangay }}, {{ addr.city }}, {{ addr.province ? addr.province ~ ', ' : '' }}{{ addr.region }}{{ addr.postalCode ? ' ' ~ addr.postalCode : '' }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>

<!-- Address Add/Edit Modal -->
<div id="addressModal" class="confirm-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div class="confirm-modal" style="max-width: 580px; width: 100%; max-height: 90vh; overflow-y: auto; text-align: left; padding: 24px; border-radius: 12px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #edf2ed; padding-bottom: 12px;">
            <h3 id="addressModalTitle" style="margin: 0; font-family: var(--document-font); color: var(--palette-dark-green); font-size: 1.25rem;">
                Add New Delivery Address
            </h3>
            <button type="button" onclick="closeAddressModal()" style="background: none; border: none; font-size: 1.25rem; color: var(--palette-gray); cursor: pointer;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="addressModalForm" method="POST" action="{{ path('app_account') }}" class="account-form" style="display: flex; flex-direction: column; gap: 12px;">
            <input type="hidden" name="action" id="address_form_action" value="add_address">
            <input type="hidden" name="address_id" id="address_form_id" value="">
            <input type="hidden" name="_csrf_token" id="address_form_csrf" value="{{ csrf_token('add_address') }}">
            <input type="hidden" id="token_add_address" value="{{ csrf_token('add_address') }}">
            <input type="hidden" id="token_edit_address" value="{{ csrf_token('edit_address') }}">

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="account-field" style="margin: 0;">
                    <label for="modal_recipient_name">Recipient Name *</label>
                    <input type="text" id="modal_recipient_name" name="recipient_name" placeholder="Full name" required>
                </div>
                <div class="account-field" style="margin: 0;">
                    <label for="modal_phone_number">Phone Number *</label>
                    <input type="text" id="modal_phone_number" name="phone_number" placeholder="09171234567" required>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="account-field" style="margin: 0;">
                    <label for="modal_region">Region *</label>
                    <input type="text" id="modal_region" name="region" placeholder="e.g. Metro Manila (NCR)" required>
                </div>
                <div class="account-field" style="margin: 0;">
                    <label for="modal_province">Province</label>
                    <input type="text" id="modal_province" name="province" placeholder="e.g. Rizal (Optional)">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="account-field" style="margin: 0;">
                    <label for="modal_city">City / Municipality *</label>
                    <input type="text" id="modal_city" name="city" placeholder="e.g. Makati City" required>
                </div>
                <div class="account-field" style="margin: 0;">
                    <label for="modal_barangay">Barangay *</label>
                    <input type="text" id="modal_barangay" name="barangay" placeholder="e.g. San Antonio" required>
                </div>
            </div>

            <div class="account-field" style="margin: 0;">
                <label for="modal_street_address">Street Name, Building, House No. *</label>
                <input type="text" id="modal_street_address" name="street_address" placeholder="e.g. Unit 4B, 123 Botanical Ave." required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="account-field" style="margin: 0;">
                    <label for="modal_postal_code">Postal Code (ZIP)</label>
                    <input type="text" id="modal_postal_code" name="postal_code" placeholder="e.g. 1203">
                </div>
                <div class="account-field" style="margin: 0;">
                    <label for="modal_label">Address Label</label>
                    <input type="text" id="modal_label" name="label" placeholder="e.g. Home, Office" value="Home">
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 8px; margin: 4px 0 10px 0;">
                <input type="checkbox" id="modal_is_default" name="is_default" value="1" style="accent-color: var(--palette-dark-green); width: 16px; height: 16px; cursor: pointer;">
                <label for="modal_is_default" style="font-size: 0.9rem; color: #333; cursor: pointer; margin: 0;">Set as default delivery address</label>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; border-top: 1px solid #edf2ed; padding-top: 14px;">
                <button type="button" class="account-btn secondary" onclick="closeAddressModal()">Cancel</button>
                <button type="submit" class="account-btn" id="modal_submit_btn">Save Address</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddressModal(mode) {
        const modal = document.getElementById('addressModal');
        const title = document.getElementById('addressModalTitle');
        const form = document.getElementById('addressModalForm');
        const actionInput = document.getElementById('address_form_action');
        const idInput = document.getElementById('address_form_id');
        const csrfInput = document.getElementById('address_form_csrf');
        const submitBtn = document.getElementById('modal_submit_btn');

        if (mode === 'add') {
            title.textContent = 'Add New Delivery Address';
            actionInput.value = 'add_address';
            idInput.value = '';
            csrfInput.value = '{{ csrf_token('add_address') }}';
            submitBtn.textContent = 'Save Address';
            form.reset();
            document.getElementById('modal_label').value = 'Home';
        }

        modal.style.display = 'flex';
    }

    function openEditAddressModal(addr) {
        openAddressModal('edit');
        const title = document.getElementById('addressModalTitle');
        const actionInput = document.getElementById('address_form_action');
        const idInput = document.getElementById('address_form_id');
        const csrfInput = document.getElementById('address_form_csrf');
        const submitBtn = document.getElementById('modal_submit_btn');

        title.textContent = 'Edit Delivery Address';
        actionInput.value = 'edit_address';
        idInput.value = addr.address_id;
        csrfInput.value = document.getElementById('token_edit_address')?.value || '';
        submitBtn.textContent = 'Update Address';

        document.getElementById('modal_recipient_name').value = addr.recipient_name || '';
        document.getElementById('modal_phone_number').value = addr.phone_number || '';
        document.getElementById('modal_region').value = addr.region || '';
        document.getElementById('modal_province').value = addr.province || '';
        document.getElementById('modal_city').value = addr.city || '';
        document.getElementById('modal_barangay').value = addr.barangay || '';
        document.getElementById('modal_street_address').value = addr.street_address || '';
        document.getElementById('modal_postal_code').value = addr.postal_code || '';
        document.getElementById('modal_label').value = addr.label || 'Home';
        document.getElementById('modal_is_default').checked = !!addr.is_default;
    }

    function closeAddressModal() {
        document.getElementById('addressModal').style.display = 'none';
    }
</script>
