{% from 'partials/order_status_badge.html.twig' import badge %}
<div class="panel-header-row">
    <div>
        <h2>Admin Overview & Dashboard</h2>
        <p class="subtext">Real-time overview of store activity, products, and customer orders.</p>
    </div>
</div>

<!-- Stat Counters -->
<div class="admin-stats-grid">
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <h4>Total Accounts</h4>
            <span>{{ users_count }}</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-user-gear"></i></div>
        <div class="stat-meta">
            <h4>Total Staff</h4>
            <span>{{ staff_count }}</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
        <div class="stat-meta">
            <h4>Products in Catalog</h4>
            <span>{{ products_count }}</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-receipt"></i></div>
        <div class="stat-meta">
            <h4>Total Orders</h4>
            <span>{{ orders_count }}</span>
        </div>
    </div>
</div>

<!-- Recent Order Logs Table -->
<section class="account-panel" style="padding: 0; border: none; box-shadow: none; background: transparent;">
    <div class="panel-header-row" style="margin-top: 24px;">
        <div>
            <h3 style="font-family: var(--heading-font); color: var(--palette-dark-green); font-size: 1.3rem; margin: 0 0 4px 0;">Recent Orders</h3>
            <p class="subtext">Latest purchases placed in the shop.</p>
        </div>
        <a href="?tab=logs" class="account-btn outline" style="padding: 8px 14px; font-size: 0.85rem;">
            View Full Logs &rarr;
        </a>
    </div>

    <div class="table-responsive">
        <table class="account-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                
                {% if recent_orders is empty %}
                    <tr>
                        <td colspan="6" class="empty-table-cell">No recent orders found.</td>
                    </tr>
                {% else %}
                    {% for order in recent_orders %}
                        <tr>
                            <td><strong>#{{ '%05d'|format(order.id) }}</strong></td>
                            <td>
                                <strong>{{ order.user.username|default('Unknown') }}</strong>
                                <span class="cell-email" title="{{ order.user.email|default('') }}" style="display: block; font-size: 0.8rem; color: var(--palette-gray);">{{ (order.user.email|default(''))|middle_truncate }}</span>
                            </td>
                            <td>{{ order.orderDate|date('M d, Y · h:i A') }}</td>
                            <td><strong>₱{{ order.totalAmount|number_format(2) }}</strong></td>

                            <td>
                                {{ badge(order.status) }}
                            </td>
                            <td style="text-align: right;">
                                <a href="{{ path('app_checkout_summary', { order_id: order.id }) }}" class="table-btn-action primary" style="text-decoration: none; display: inline-flex; padding: 6px 12px; font-size: 0.8rem;" title="View Order Summary">
                                    <i class="fa-solid fa-file-invoice"></i> View
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</section>
