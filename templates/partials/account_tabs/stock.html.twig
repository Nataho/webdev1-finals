<section class="account-panel">
    <div class="panel-header-row">
        <div>
            <h2>Stock & Inventory</h2>
            {% if is_granted('ROLE_ADMIN') %}
                <p class="subtext">Manage current stock levels and inventory quantities for the store.</p>
            {% else %}
                <p class="subtext">Browse the whole catalog. You can edit stock and delete only the products you created.</p>
            {% endif %}
        </div>
    </div>

    <!-- Search Products -->
    <form method="GET" class="tab-search-bar" action="{{ path('app_account') }}#stock">
        <input type="hidden" name="tab" value="stock">
        <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="stock_q" placeholder="Search product name..." value="{{ stock_q ?? '' }}">
        </div>
        <button type="submit" class="account-btn secondary">Search</button>
        {% if stock_q is defined and stock_q %}
            <a href="{{ path('app_account', { tab: 'stock' }) }}#stock" class="account-btn outline">Clear</a>
        {% endif %}
    </form>

    <!-- Products Stock Table -->
    <div class="table-responsive">
        <table class="account-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Current Stock</th>
                    <th>Created by</th>
                    <th style="text-align: right;">Update Stock</th>
                </tr>
            </thead>
            <tbody>
                {% if admin_products_list is defined and admin_products_list|length > 0 %}
                    {% for prod in admin_products_list %}
                        {% set qty = prod.productStockQuantity|number_format %}
                        {% set stock_badge_class = qty <= 0 ? 'stock-out' : (qty <= 5 ? 'stock-low' : 'stock-ok') %}
                        {% set stock_badge_text = qty <= 0 ? 'Out of stock' : (qty <= 5 ? 'Low stock' : 'In stock') %}
                        {% set can_manage = is_granted('ROLE_ADMIN') or (prod.createdBy and prod.createdBy.id == app.user.id) %}
                        <tr>
                            <td>
                                <div class="table-prod-name">
                                    <strong>{{ prod.productName }}</strong>
                                    <span class="stock-pill {{ stock_badge_class }}">{{ stock_badge_text }}</span>
                                </div>
                            </td>
                            <td>₱{{ prod.productPrice|number_format(2) }}</td>
                            <td>
                                <strong style="font-size: 1.05rem;">{{ qty }}</strong> <span style="font-size: 0.8rem; color: #888;">units</span>
                            </td>
                            <td>
                                {% if prod.createdBy %}
                                    {{ prod.createdBy.username }}
                                    {% if prod.createdBy.id == app.user.id %}<span style="font-size: 0.8rem; color: #888;">(you)</span>{% endif %}
                                {% else %}
                                    <span style="color: #888;">—</span>
                                {% endif %}
                            </td>
                            <td style="text-align: right;">
                                {% if can_manage %}
                                    <div style="display: inline-flex; gap: 6px; justify-content: flex-end; align-items: center;">
                                        <button type="button" class="table-btn-action" title="Edit Product" onclick="prepareEditProduct(this)"
                                            data-product-id="{{ prod.id }}"
                                            data-product-name="{{ prod.productName }}"
                                            data-product-price="{{ prod.productPrice }}"
                                            data-product-description="{{ prod.productDescription|e('html_attr') }}"
                                            data-product-img="{{ prod.productImg }}">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <form method="POST" action="{{ path('app_account', { tab: 'stock' }) }}" class="stock-update-form" style="display: inline-flex; gap: 6px; align-items: center;">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('update_stock') }}">
                                            <input type="hidden" name="action" value="update_stock">
                                            <input type="hidden" name="product_id" value="{{ prod.id }}">
                                            <input type="number" name="new_stock" value="{{ qty }}" data-initial="{{ qty }}" min="0" step="1" required class="stock-input">
                                            <button type="submit" class="table-btn-action primary" title="Save Stock" disabled>
                                                <i class="fa-solid fa-check"></i> Save
                                            </button>
                                        </form>
                                        <button type="button" class="table-btn-action danger" title="Delete Product" onclick="prepareDeleteProduct({{ prod.id }})">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                {% else %}
                                    <span title="Only the product's creator or an admin can edit this listing" style="color: var(--palette-gray); font-size: 0.85rem;">
                                        <i class="fa-solid fa-lock"></i> Read only
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="5" class="empty-table-cell">No products found.</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.stock-update-form').forEach(form => {
                const input = form.querySelector('.stock-input');
                const btn = form.querySelector('button[type="submit"]');
                if (!input || !btn) return;

                const checkChanged = () => {
                    const initial = String(input.dataset.initial ?? '').trim();
                    const current = String(input.value ?? '').trim();
                    // Enable only if non-empty, changed from initial, and valid non-negative integer
                    if (current !== '' && current !== initial && Number(current) >= 0) {
                        btn.removeAttribute('disabled');
                    } else {
                        btn.setAttribute('disabled', 'disabled');
                    }
                };

                input.addEventListener('input', checkChanged);
                input.addEventListener('change', checkChanged);
            });
        });
    </script>
</section>
