<section class="account-panel">
    <div class="panel-header-row">
        <div>
            <h2>Manage Users</h2>
            <p class="subtext">Create, edit, and manage every account's role and access.</p>
        </div>
        <button type="button" class="account-btn" onclick="prepareAddUser()">
            <i class="fa-solid fa-user-plus"></i> Add User
        </button>
    </div>

    <!-- Search / Filter Bar -->
    <form method="GET" class="tab-search-bar" action="{{ path('app_account') }}#users">
        <input type="hidden" name="tab" value="users">
        <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="user_q" placeholder="Search by username or email..." value="{{ user_q }}">
        </div>
        <button type="submit" class="account-btn secondary">Search</button>
        {% if user_q %}
            <a href="{{ path('app_account', { tab: 'users' }) }}#users" class="account-btn outline">Clear</a>
        {% endif %}
    </form>

    <!-- Users Table -->
    <div class="table-responsive">
        <table class="account-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role / Status</th>
                    <th>Created</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% if admin_users_list is empty %}
                    <tr>
                        <td colspan="5" class="empty-table-cell">No accounts found matching your search.</td>
                    </tr>
                {% else %}
                    {% for u in admin_users_list %}
                        <tr>
                            <td>
                                <div class="table-user-cell">
                                    <strong>{{ u.user_name }}</strong>
                                    {% if u.user_id == user.id %}
                                        <span class="badge-mini you">You</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td><span class="cell-email" title="{{ u.user_email }}">{{ u.user_email|middle_truncate }}</span></td>
                            <td>
                                {% if u.user_role == "banned"%}
                                    <span class="badge-status banned"><i class="fa-solid fa-ban"></i> Banned</span>
                                {% elseif u.user_role == "staff" %}
                                    <span class="badge-status staff"><i class="fa-solid fa-user-gear"></i> Staff</span>
                                {% elseif u.user_role == "admin" %}
                                    <span class="badge-status admin"><i class="fa-solid fa-shield-halved"></i> Admin</span>
                                {% else %}
                                    <span class="badge-status active"><i class="fa-solid fa-circle-check"></i> Customer</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if u.user_created_at %}
                                    {{ u.user_created_at|date('M d, Y') }}
                                {% else %}
                                    <span style="color: var(--palette-gray);" title="Created before this column was tracked">—</span>
                                {% endif %}
                            </td>
                            <td style="text-align: right;">
                                {% if u.user_id != user.id %}
                                    <div style="display: inline-flex; gap: 6px; align-items: center;">
                                        {# edit opens the prefilled modal — the row's data feeds prepareEditUser() #}
                                        <button type="button" class="table-btn-action primary" title="Edit User"
                                                data-user-id="{{ u.user_id }}" data-user-name="{{ u.user_name }}"
                                                data-user-email="{{ u.user_email }}" data-user-role="{{ u.user_role }}"
                                                onclick="prepareEditUser(this)">
                                            <i class="fa-solid fa-user-pen"></i> Edit
                                        </button>

                                        {% if u.user_role != "admin" %}
                                            <button type="button" class="table-btn-action danger" title="Delete User" onclick="prepareDeleteUser({{ u.user_id }})">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        {% endif %}

                                        {% if u.user_role == "banned" %}
                                            <form method="POST" action="{{ path('app_account', { tab: 'users' }) }}" style="display: inline;">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('toggle_user_ban') }}">
                                                <input type="hidden" name="action" value="toggle_user_ban">
                                                <input type="hidden" name="target_user_id" value="{{ u.user_id }}">
                                                <input type="hidden" name="target_action" value="unban">
                                                <button type="submit" class="table-btn-action success" title="Unban User">
                                                    <i class="fa-solid fa-unlock"></i> Unban
                                                </button>
                                            </form>
                                        {% else %}
                                            <form method="POST" action="{{ path('app_account', { tab: 'users' }) }}" style="display: inline;">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('toggle_user_ban') }}">
                                                <input type="hidden" name="action" value="toggle_user_ban">
                                                <input type="hidden" name="target_user_id" value="{{ u.user_id }}">
                                                <input type="hidden" name="target_action" value="ban">
                                                <button type="submit" class="table-btn-action danger" title="Ban User">
                                                    <i class="fa-solid fa-ban"></i> Ban
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span style="font-size: 0.8rem; color: var(--palette-gray); font-style: italic;">(Self)</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</section>
