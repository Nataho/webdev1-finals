<header>
        <h1>ESTRERA BOTANICALS</h1>
        <nav>
            <a class="heading-nav" href="{{ path('app_home') }}">HOME</a>
            <a class="heading-nav" href="{{ path('app_shop') }}"> SHOP</a>
            <a class="heading-nav" href="{{ path('app_shop', {filter: 'best_sellers'}) }}">BEST SELLERS</a>
            <a class="heading-nav" href="{{ path('app_about_us') }}">ABOUT US</a>

            {% if app.user %} {# if user exsists #}
                {% if is_granted('ROLE_ADMIN') %}
                    {# admins land on their dashboard through the protected admin door #}
                    <a class="heading-nav" id="heading-cta-button" href="{{ path('app_admin_account', { tab: 'dashboard' }) }}">Manage</a>
                {% elseif is_granted('ROLE_STAFF') %}
                    {# staff land straight in their product work area #}
                    <a class="heading-nav" id="heading-cta-button" href="{{ path('app_account', { tab: 'stock' }) }}">My Products</a>
                {% else %}
                    <a class="heading-nav" id="heading-cta-button" href="{{ path('app_account') }}">My Account</a>
                {% endif %}
            {% else %} {# if user don't exsist #}
                <a class="heading-nav" id="heading-cta-button" href="{{ path('app_shop') }}">Shop Now</a>
            {% endif %}
        </nav>
</header>