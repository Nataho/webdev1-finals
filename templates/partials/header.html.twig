<header>
        <h1>ESTRERA BOTANICALS</h1>
        <button type="button" class="nav-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-nav">
            <i class="fa-solid fa-bars"></i>
            <i class="fa-solid fa-xmark"></i>
        </button>
        <nav id="site-nav">
            <a class="heading-nav" href="{{ path('app_home') }}">HOME</a>
            <a class="heading-nav" href="{{ path('app_shop') }}"> SHOP</a>
            <a class="heading-nav" href="{{ path('app_shop', {filter: 'best_sellers'}) }}">BEST SELLERS</a>
            <a class="heading-nav" href="{{ path('app_about_us') }}">ABOUT US</a>

            {% if app.user %} {# if user exsists #}
                {% if is_granted('ROLE_ADMIN') %}
                    {# admins land on their dashboard through the protected admin door #}
                    <a class="heading-nav" id="heading-cta-button" href="{{ path('app_admin_account', { tab: 'dashboard' }) }}">Manage</a>
                {% elseif is_granted('ROLE_STAFF') %}
                    {# staff land straight in their product work area #}
                    <a class="heading-nav" id="heading-cta-button" href="{{ path('app_account', { tab: 'stock' }) }}">My Products</a>
                {% else %}
                    <a class="heading-nav" id="heading-cta-button" href="{{ path('app_account') }}">My Account</a>
                {% endif %}
            {% else %} {# if user don't exsist #}
                <a class="heading-nav" id="heading-cta-button" href="{{ path('app_shop') }}">Shop Now</a>
            {% endif %}
        </nav>
        <div class="nav-backdrop" aria-hidden="true"></div>
</header>
<script>
    (function () {
        var header = document.querySelector('header');
        var toggle = header ? header.querySelector('.nav-toggle') : null;
        if (!toggle) { return; }

        function setOpen(open) {
            header.classList.toggle('nav-open', open);
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        toggle.addEventListener('click', function () {
            setOpen(!header.classList.contains('nav-open'));
        });

        // picking a destination closes the drawer
        header.querySelectorAll('nav a.heading-nav').forEach(function (link) {
            link.addEventListener('click', function () { setOpen(false); });
        });

        // tapping the dimmed page closes it too
        var backdrop = header.querySelector('.nav-backdrop');
        if (backdrop) {
            backdrop.addEventListener('click', function () { setOpen(false); });
        }
    })();
</script>